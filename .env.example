# Required BEFORE any runtime literature search.
# Copy to .env (git-ignored) and fill values. Never commit real keys.

GOOGLE_SCHOLAR_API_PROVIDER=serpapi
GOOGLE_SCHOLAR_API_KEY=
GOOGLE_SCHOLAR_API_ENDPOINT=https://serpapi.com/search

# Optional
GOOGLE_SCHOLAR_ENGINE=google_scholar
GOOGLE_SCHOLAR_LANGUAGE=en
GOOGLE_SCHOLAR_REGION=
GOOGLE_SCHOLAR_RESULTS_PER_PAGE=20
GOOGLE_SCHOLAR_MAX_PAGES=5
GOOGLE_SCHOLAR_RATE_LIMIT=1.0

# Zotero (optional but recommended)
ZOTERO_API_KEY=
ZOTERO_USER_ID=
