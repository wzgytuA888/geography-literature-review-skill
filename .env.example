# v2 academic API configuration. Copy to .env; never commit real credentials.

# Optional. Semantic Scholar public access is attempted when blank.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_RATE_LIMIT=1.0

# Recommended contact email for polite API pools.
OPENALEX_MAILTO=
OPENALEX_RATE_LIMIT=0.2
CROSSREF_MAILTO=
CROSSREF_RATE_LIMIT=0.2

# Optional Zotero integration
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# Legacy/manual Google Scholar gateway; never required by v2 discovery.
GOOGLE_SCHOLAR_API_PROVIDER=
GOOGLE_SCHOLAR_API_KEY=
GOOGLE_SCHOLAR_API_ENDPOINT=
