flowchart TB
    subgraph BENCH["Reference Review Benchmark Corpus<br/>(60 high-quality geography reviews)"]
        BC["benchmark_corpus/<br/>pattern cards · consolidated patterns · rubric"]
    end
    subgraph DISTILL["Compile-time: Review-Method Distillation"]
        BT["Book-to-Skill principles:<br/>structure · procedure · decision rules"]
        DM["Distilled Review Method Skill<br/>(HOW to review)"]
    end
    BC --> BT --> DM

    subgraph RUNTIME["Runtime: Task-specific Review (per user topic)"]
        UT["User Review Topic"] --> PF["Academic API Preflight"]
        PF --> LS["Parallel Literature Retrieval<br/>(Semantic Scholar + OpenAlex)"]
        LS --> SCR["Screening / Dedup"]
        SCR --> FT["Legal Full-text Acquisition"]
        FT --> GATE{"MissingFullTextGate"}
        GATE -- "important PDF missing" --> PAUSE["PAUSED_WAITING_FOR_USER_FULLTEXT<br/>TXT/XLSX report → user → resume"]
        GATE -- clear --> EV["Task Evidence Corpus<br/>cards · matrix · argument map"]
        EV --> SYN["Cross-study Synthesis"]
        SYN --> OUT["Outline"] --> DRAFT["Drafting"] --> CITE["Zotero Citation Resolution"] --> FIGS["Figures"] --> RA["Review / Audit / Benchmark-QA"] --> FINAL["Final Manuscript"]
    end

    DM -. "provides HOW only<br/>(never facts)" .-> OUT
    DM -. "style & structure priors" .-> DRAFT
    DM -. "figure grammar" .-> FIGS
    PAUSE -. "user supplies PDF" .-> FT

    style BENCH fill:#e8f0e8
    style RUNTIME fill:#e8eef8
    style PAUSE fill:#ffe0e0
